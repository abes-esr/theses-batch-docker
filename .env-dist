# ===================================================================
# theses-batch-docker : Variables d'environnement
# ===================================================================
# Marche à suivre :
#   1. Copier ce fichier sous le nom .env :
#        cp .env-dist .env
#   2. Adapter les variables ci-dessous selon votre environnement (serveur/prod/test)
#   3. Démarrer les deux conteneurs :
#        docker compose up -d
#
# Remarque : Les deux conteneurs (theses-batch-anr et theses-batch-datagouv)
# tournent en permanence pour être supervisés par WUD et partagent ce même .env.
# ===================================================================

# -------------------------------------------------------------------
# Image Docker & Version (utilisée également par WUD)
# -------------------------------------------------------------------
THESES_BATCH_IMAGE=abesesr/theses-batch
THESES_BATCH_VERSION=latest

# -------------------------------------------------------------------
# Limites de ressources (Capping) des conteneurs
# -------------------------------------------------------------------
RESTART_POLICY=unless-stopped

# Conteneur ANR (intensif en CPU et RAM pour le parsing PDF multi-threadé)
MEM_LIMIT_ANR=16g
MEMSWAP_LIMIT_ANR=16g
CPU_LIMIT_ANR=16

# Conteneur Datagouv (plus léger : requêtes API HTTP et sérialisation)
MEM_LIMIT_DATAGOUV=4g
MEMSWAP_LIMIT_DATAGOUV=4g
CPU_LIMIT_DATAGOUV=4

# -------------------------------------------------------------------
# Volumes & Répertoires persistants (H2 et Sorties isolés par conteneur)
# -------------------------------------------------------------------
# Volumes Batch ANR
THESES_BATCH_ANR_INPUT_DIR=/starstock
THESES_BATCH_ANR_OUTPUT_DIR=volumes/output-anr
THESES_BATCH_DATA_H2_ANR=volumes/data-anr
THESES_BATCH_ANR_INPUT_FONTS_DIR=volumes/fonts
THESES_BATCH_ANR_FONTS_DIR=/fonts

# Volumes Batch Datagouv
THESES_BATCH_DATAGOUV_OUTPUT_DIR=volumes/output-datagouv
THESES_BATCH_DATA_H2_DATAGOUV=volumes/data-datagouv

# -------------------------------------------------------------------
# Planification
# -------------------------------------------------------------------
# Batch ANR : aucun cron interne, lancement uniquement par ./scripts/run-anr.sh

# Batch Datagouv : planification cronie (Abes)
# Évaluation quotidienne de la règle des 6 mois à 2h00 du matin
THESES_BATCH_DATAGOUV_CRON=0 2 * * *

# -------------------------------------------------------------------
# Options de la Machine Virtuelle Java (JVM)
# -------------------------------------------------------------------
THESES_BATCH_JAVA_XMX_ANR=14g
THESES_BATCH_JAVA_XMX_DATAGOUV=3g
THESES_BATCH_HEAP_DUMP_DIR=/output
THESES_BATCH_JAVA_OPTS=

# -------------------------------------------------------------------
# OpenTelemetry (agent Java désactivé par défaut ; true pour l'activer)
# -------------------------------------------------------------------
# Le nom de service est fixé par conteneur dans docker-compose (theses-batch-anr / theses-batch-datagouv)
OTEL_ENABLED=false
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=lab,service.namespace=theses-batch,service.version=1.0.0
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Collecteur OTLP à renseigner (sans valeur, l'agent essaie localhost:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=

# -------------------------------------------------------------------
# Paramètres Métier du Batch ANR
# -------------------------------------------------------------------
THESES_BATCH_ANR_PATTERN=ANR-(?:\d{2}-)?[A-Za-z0-9]{4,8}(?:-\d{1,4})?|Agence nationale de la recherche|Labex|\bPIA\b
THESES_BATCH_ANR_MAX_FILES=500000
THESES_BATCH_ANR_OFFSET=0
THESES_BATCH_ANR_NB_PAGES=50
THESES_BATCH_ANR_CONTEXT_CHARACTERS=50
THESES_BATCH_ANR_CHUNK_SIZE=500
THESES_BATCH_ANR_EXCLUDE_KEYWORDS=annexe,resume,résumé,abstract,errata,summary,erratum,annexes,appendix,appendices,titre,couverture,couv,cover,synthese,synthèse,glossaire,illustr,diff,image,table,sommaire,garde,planche,annnexe,annex_
THESES_BATCH_ANR_WRITERS_ENABLED=csv,json
THESES_BATCH_ANR_WRITERS_HEADER=file_path,file_name,page_number,match_value,preceding_context,following_context,analyzed_pages_number,total_pages,processing_time,nnt,doi,defense_date,error_message
THESES_BATCH_ANR_JSON_PRETTY_PRINT=true
THESES_BATCH_ANR_SCAN_THREADS=32
THESES_BATCH_ANR_PROCESS_THREADS=16
THESES_BATCH_ANR_START_FILE=
THESES_BATCH_ANR_EXCLUDE_DIRS=*/*/temp
THESES_BATCH_ANR_PROGRESS_INTERVAL=30s
THESES_BATCH_ANR_IN_MEMORY_MAX_SIZE=64MB
THESES_BATCH_ANR_READ_BLOCK_SIZE=128KB

# Serveur Solr (Enrichissement ANR)
THESES_BATCH_SOLR_ENABLED=true
THESES_BATCH_SOLR_BASE_URL=http://denim.v102.abes.fr:8080/solr1
THESES_BATCH_SOLR_ID_FIELD=id
THESES_BATCH_SOLR_NNT_FIELD=nnt
THESES_BATCH_SOLR_DOI_FIELD=doi
THESES_BATCH_SOLR_DEFENSE_DATE_FIELD=dateSoutenance_dt
THESES_BATCH_SOLR_CONNECT_TIMEOUT=5000
THESES_BATCH_SOLR_READ_TIMEOUT=5000

# -------------------------------------------------------------------
# Paramètres Métier du Batch Datagouv
# -------------------------------------------------------------------
# API theses.fr (interrogation et pagination des thèses soutenues)
THESES_API_BASE_URL=
THESES_PAGE_SIZE=1000
THESES_CONNECT_TIMEOUT=30s
THESES_READ_TIMEOUT=60s

# API data.gouv.fr (téléversement multipart des 4 fichiers : CSV, JSON, JSONL, JSONL.gz)
DATA_GOUV_API_KEY=
DATA_GOUV_DATASET_ID=61d42893146c465c7bbac85f
DATA_GOUV_CSV_RESOURCE_ID=eb06a4f5-a9f1-4775-8226-33425c933272
DATA_GOUV_JSON_RESOURCE_ID=d4f0a317-4fd7-4850-bfa2-829a2a4a21df
DATA_GOUV_JSONL_RESOURCE_ID=78d463e4-b787-4b1f-86d5-e52e4fb86f1d
DATA_GOUV_JSONL_GZ_RESOURCE_ID=

# Contrôle du téléversement (true = envoi effectif vers data.gouv.fr, false = génération locale uniquement)
DATA_GOUV_UPLOAD_ENABLED=false
# Taille des morceaux d'envoi des gros fichiers (un seul morceau en mémoire à la fois)
DATA_GOUV_UPLOAD_CHUNK_SIZE=10MB

# Mode Test (true = limite l'export à 50 thèses et force l'exécution)
MODE_TEST=false

# Forçage manuel (true = ignore la règle des 6 mois et lance le job Datagouv immédiatement)
FORCE_RUN=false

# -------------------------------------------------------------------
# Logs Elastic & Supervision Abes
# -------------------------------------------------------------------
ELASTIC_LOGS_APPLI=theses
